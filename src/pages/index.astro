---
import '../styles/global.css';
import SketchIcon from '../components/SketchIcon.astro';

const configuredBase = import.meta.env.BASE_URL;
const base = configuredBase.endsWith('/') ? configuredBase : `${configuredBase}/`;
const coffeeBookingUrl = 'https://calendar.app.google/ZcQgL58joEkLaMBc7';

const projects = [
  {
    title: 'Workout Tracker',
    date: 'Sep 2026',
    labels: ['Apps Script', 'Mobile workflow', 'Private tooling'],
    href: `${base}workout-tracker/`,
    visual: 'workout',
  },
  {
    title: 'Personal OS',
    date: 'Apr 2026',
    labels: ['Context engineering', 'AI workflow design', 'Knowledge management'],
    href: `${base}personal-os/`,
    visual: 'personal-os',
  },
  {
    title: 'Flavour Lab',
    date: 'Aug 2026',
    labels: ['AI product design', 'AI contracts', 'Mobile web app'],
    href: `${base}flavour-lab/`,
    visual: 'flavour-lab',
  },
];

const flavourLabThoughts = [
  'Grr, I love cooking but hate how much time it takes!',
  'Hmm, what if AI could do it for me?',
  'Well, a robot chef would need to navigate the space, handle tools... but wait, what if I redesigned a kitchen around the robot?',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Selected systems, products and writing by Amanda Esnaola."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Amanda Esnaola · Proof of Work</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="site-header">
        <div class="introduction">
          <p class="name">Amanda Esnaola</p>
          <p class="intro-copy">
            I’m an operator and a writer, curious about what makes people and systems tick,
            and with a soft spot for spreadsheets. I'm not technical by training but I am
            building things, increasingly with AI; and in the words of Joan Didion,
          </p>
          <p class="intro-quote">
            I write entirely to find out what I'm thinking, what I'm looking at, what I see
            and what it means. What I want and what I fear.
          </p>
          <p class="work-intro">Here’s a selection of both.</p>
          <p class="thought-note">
            P.S. Hover over the mouse (or click on mobile) to see the side questions,
            connections and tangents that surfaced while I was building it.
          </p>
        </div>
        <nav class="profile-links" aria-label="Profile links">
          <a class="profile-link" href="https://github.com/amandaklafke92" aria-label="github">
            <span class="profile-label">github</span>
            <span class="profile-icon"><SketchIcon name="github" /></span>
          </a>
          <a class="profile-link" href="https://www.linkedin.com/in/amanda-esnaola/" aria-label="linkedin">
            <span class="profile-label">linkedin</span>
            <span class="profile-icon"><SketchIcon name="linkedin" /></span>
          </a>
          <a class="profile-link" href={coffeeBookingUrl} aria-label="virtual coffee — book a chat">
            <span class="profile-label">virtual coffee</span>
            <span class="profile-icon"><SketchIcon name="coffee" /></span>
          </a>
        </nav>
      </header>

      <section aria-label="Selected projects and writing">
        <div class="filter-tabs" role="group" aria-label="Filter work">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          <button type="button" data-filter="project" aria-pressed="false">Projects</button>
          <button type="button" data-filter="writing" aria-pressed="false">Writing</button>
        </div>

        <div class="work-grid" aria-live="polite">
          {projects.map((project) => (
            <article
              class={`work-card visual-${project.visual}`}
              data-kind="project"
              data-thought-card={project.visual === 'flavour-lab' ? '' : undefined}
            >
              <a
                class="work-card-link"
                href={project.href}
                aria-label={`Open ${project.title}`}
              >
                <div class="card-meta">
                  <h2>{project.title}</h2>
                  <time>{project.date}</time>
                  <p class="card-labels">
                    {project.labels.map((label) => <span>{label}</span>)}
                  </p>
                </div>

                <div class="visual-stage">
                  {project.visual === 'workout' && (
                    <div class="phone-frame">
                      <div class="phone-camera" aria-hidden="true"></div>
                      <img
                        src={`${base}workout-tracker/assets/workout-tracker-complete.png`}
                        alt="Workout Tracker training distribution screen"
                      />
                    </div>
                  )}

                  {project.visual === 'flavour-lab' && (
                    <div class="phone-frame">
                      <div class="phone-camera" aria-hidden="true"></div>
                      <video
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        poster={`${base}flavour-lab/assets/suggestions.png`}
                        aria-label="Flavour Lab workflow from recipe selection through generated suggestions"
                      >
                        <source src={`${base}assets/flavour-lab-loop.mp4`} type="video/mp4" />
                      </video>
                    </div>
                  )}

                  {project.visual === 'personal-os' && (
                    <div class="tree-window" aria-label="Personal OS file tree">
                      <div class="tree-title">amanda-os / workspace</div>
                      <div class="tree-content" aria-hidden="true">
                        <p><span>▾</span> core-context</p>
                        <p class="depth-one"><span>·</span> priorities.md</p>
                        <p class="depth-one"><span>·</span> how-i-work.md</p>
                        <p><span>▾</span> projects</p>
                        <p class="depth-one"><span>▾</span> workout-tracker</p>
                        <p class="depth-two"><span>·</span> AGENTS.md</p>
                        <p class="depth-two"><span>·</span> logs</p>
                        <p><span>›</span> knowledge</p>
                        <p><span>›</span> skills</p>
                      </div>
                    </div>
                  )}
                </div>
              </a>

              {project.visual === 'flavour-lab' && (
                <>
                  <button
                    class="thought-trigger"
                    type="button"
                    aria-expanded="false"
                    aria-controls="flavour-lab-thoughts"
                    data-thought-trigger
                  >
                    <svg class="thought-mouse" viewBox="0 0 92 72" aria-hidden="true">
                      <path d="M31 57c-12 0-20-7-20-17 0-12 10-22 25-22 13 0 26 9 26 22 0 10-8 17-20 17H31Z" />
                      <path d="M22 22c-5-8 3-15 10-8M46 17c2-9 11-8 11 1" />
                      <path d="M62 47c12 1 17 8 23 2" />
                      <circle cx="42" cy="31" r="1.8" />
                      <circle cx="53" cy="31" r="1.8" />
                      <path d="M47 38c2 2 5 2 7 0M39 39l-9 2M39 43l-9 4M56 39l9 2M56 43l9 4" />
                      <circle class="thought-dot-large" cx="72" cy="17" r="5" />
                      <circle class="thought-dot-small" cx="82" cy="8" r="2.6" />
                    </svg>
                    <span class="sr-only">Open Flavour Lab scratchpad</span>
                  </button>

                  <aside
                    class="thought-bubble"
                    id="flavour-lab-thoughts"
                    aria-label="Thought trail sparked by Flavour Lab"
                    aria-hidden="true"
                    data-thought-bubble
                  >
                    <button
                      class="thought-close"
                      type="button"
                      aria-label="Close thought trail"
                      data-thought-close
                    >
                      ×
                    </button>
                    <div class="thought-pages" aria-live="polite">
                      {flavourLabThoughts.map((thought, index) => (
                        <p class="thought-page" hidden={index !== 0} data-thought-page>
                          {index === 2 ? (
                            <>Well, a robot chef would need to navigate the space, handle tools... but wait, what if I redesigned a kitchen around the <em>robot</em>?</>
                          ) : thought}
                        </p>
                      ))}
                    </div>
                    <div class="thought-actions">
                      <span data-thought-position>1 of 3</span>
                      <button type="button" aria-label="Next thought" data-thought-next>›</button>
                    </div>
                  </aside>
                </>
              )}
            </article>
          ))}

          <a class="work-card visual-writing" href={`${base}writing/daddys-little-girls/`} data-kind="writing" aria-labelledby="daddys-little-girls-title">
            <div class="card-meta">
              <h2 id="daddys-little-girls-title">Daddy’s Little Girls</h2>
              <time>2024</time>
              <p class="card-labels">
                <span>Short memoir</span>
                <span>UTS Writers’ Anthology</span>
              </p>
            </div>

            <div class="visual-stage writing-stage">
              <div class="writing-excerpt">
                <span class="dinkus" aria-hidden="true">⁂</span>
                <blockquote>
                  “That day, I begin to learn that right and wrong exist within a spectrum of grey, but it will be years before I can articulate this.”
                </blockquote>
                <p><em>Blood &amp; Bone: 2024 UTS Writers’ Anthology</em></p>
              </div>
            </div>
          </a>

          <p class="empty-state" hidden data-empty-state>
            Writing will appear here when it’s ready.
          </p>
        </div>
      </section>

      <footer>
        <span>Amanda Esnaola · Sydney</span>
        <span>better systems = better life</span>
      </footer>
      <p class="coffee-invitation">
        <a class="coffee-link" href={coffeeBookingUrl} aria-label="virtual coffee? — book a chat">
          <SketchIcon name="coffee" />
          <span>virtual coffee?</span>
        </a>
      </p>
    </main>

    <script>
      const filters = [...document.querySelectorAll('[data-filter]')];
      const cards = [...document.querySelectorAll('[data-kind]')];
      const emptyState = document.querySelector('[data-empty-state]');

      filters.forEach((filter) => {
        filter.addEventListener('click', () => {
          const selected = filter.dataset.filter;
          filters.forEach((button) => {
            button.setAttribute('aria-pressed', String(button === filter));
          });

          let visibleCount = 0;
          cards.forEach((card) => {
            const visible = selected === 'all' || card.dataset.kind === selected;
            card.hidden = !visible;
            if (visible) visibleCount += 1;
          });

          emptyState.hidden = visibleCount !== 0;
        });
      });

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('video').forEach((video) => video.pause());
      }

      const thoughtCard = document.querySelector('[data-thought-card]');

      if (thoughtCard) {
        const trigger = thoughtCard.querySelector('[data-thought-trigger]');
        const bubble = thoughtCard.querySelector('[data-thought-bubble]');
        const pages = [...thoughtCard.querySelectorAll('[data-thought-page]')];
        const position = thoughtCard.querySelector('[data-thought-position]');
        const next = thoughtCard.querySelector('[data-thought-next]');
        const close = thoughtCard.querySelector('[data-thought-close]');
        const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let activeThought = 0;
        let thoughtTimer;

        const renderThought = () => {
          pages.forEach((page, index) => {
            page.hidden = index !== activeThought;
          });
          position.textContent = `${activeThought + 1} / ${pages.length}`;
          next.setAttribute(
            'aria-label',
            activeThought === pages.length - 1 ? 'Start again' : 'Next thought',
          );
          next.textContent = activeThought === pages.length - 1 ? '↺' : '›';
        };

        const stopSequence = () => {
          window.clearInterval(thoughtTimer);
        };

        const setThoughtOpen = (open) => {
          thoughtCard.dataset.thoughtOpen = String(open);
          trigger.setAttribute('aria-expanded', String(open));
          bubble.setAttribute('aria-hidden', String(!open));
          if (!open) stopSequence();
        };

        const startSequence = () => {
          stopSequence();
          activeThought = 0;
          renderThought();
          setThoughtOpen(true);

          if (!reduceMotion.matches) {
            thoughtTimer = window.setInterval(() => {
              if (activeThought === pages.length - 1) {
                stopSequence();
                return;
              }
              activeThought += 1;
              renderThought();
            }, 3600);
          }
        };

        thoughtCard.addEventListener('pointerenter', () => {
          if (canHover.matches) startSequence();
        });

        thoughtCard.addEventListener('pointerleave', () => {
          if (canHover.matches) setThoughtOpen(false);
        });

        trigger.addEventListener('click', () => {
          stopSequence();
          activeThought = 0;
          renderThought();
          setThoughtOpen(true);
        });

        next.addEventListener('click', () => {
          stopSequence();
          activeThought = (activeThought + 1) % pages.length;
          renderThought();
        });

        close.addEventListener('click', () => {
          setThoughtOpen(false);
          trigger.focus();
        });

        renderThought();
      }
    </script>
  </body>
</html>
